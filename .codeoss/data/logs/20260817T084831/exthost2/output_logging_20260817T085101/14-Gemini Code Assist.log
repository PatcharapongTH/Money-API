h tempfile.NamedTemporaryFile(\r\n            mode=\"w\",\r\n            encoding=\"utf-8\",\r\n            suffix=\".txt\",\r\n            delete=False\r\n        ) as password_file:\r\n\r\n            password_file.write(\r\n                password\r\n            )\r\n\r\n            password_file.write(\r\n                \"\\n\"\r\n            )\r\n\r\n            password_path =\r\n                password_file.name\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # Output\r\n        # ----------------------------------------------------\r\n\r\n        output_file =\r\n            tempfile.NamedTemporaryFile(\r\n                suffix=\".pdf\",\r\n                delete=False\r\n            )\r\n\r\n\r\n        output_path =\r\n            output_file.name\r\n\r\n\r\n        output_file.close()\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # qpdf\r\n        # ----------------------------------------------------\r\n\r\n        command = [\r\n\r\n            \"qpdf\",\r\n\r\n            \"--password-file=\" +\r\n            password_path,\r\n\r\n            \"--decrypt\",\r\n\r\n            input_path,\r\n\r\n            output_path\r\n\r\n        ]\r\n\r\n\r\n        result =\r\n            subprocess.run(\r\n                command,\r\n                stdout=subprocess.PIPE,\r\n                stderr=subprocess.PIPE,\r\n                text=True,\r\n                timeout=120\r\n            )\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # Check qpdf\r\n        # ----------------------------------------------------\r\n\r\n        if result.returncode != 0:\r\n\r\n            return jsonify({\r\n                \"error\":\r\n                    \"รหัสผ่านไม่ถูกต้อง หรือ PDF ไม่สามารถถอดรหัสได้\"\r\n            }), 422\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # Read output\r\n        # --------------------